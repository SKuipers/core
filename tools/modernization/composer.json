{
    "name": "gibbon/php84-modernization",
    "description": "PHP 8.4 Modernization Tool for Gibbon - Automated type hint migration and deprecation fixes",
    "type": "library",
    "license": "GPL-3.0",
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "^5.0",
        "phpstan/phpstan": "^1.8",
        "symfony/console": "^6.0",
        "antecedent/patchwork": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.3",
        "giorgiosironi/eris": "^0.14",
        "friendsofphp/php-cs-fixer": "^3.94"
    },
    "autoload": {
        "psr-4": {
            "Gibbon\\Modernization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gibbon\\Modernization\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/modernize"
    ],
    "config": {
        "platform": {
            "php": "8.1"
        }
    }
}
